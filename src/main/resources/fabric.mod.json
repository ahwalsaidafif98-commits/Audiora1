{
  "schemaVersion": 1,
  "id": "audiora_controller",
  "version": "${version}",
  "name": "Audiora Sound Controller",
  "description": "Audiora sound controller with integration for the Sounds mod audio library.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "id.audiora.controller.AudioraController"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25",
    "sounds": "*"
  },
  "mixins": [
    {
      "config": "audiora_controller.client.mixins.json",
      "environment": "client"
    }
  ]
}
